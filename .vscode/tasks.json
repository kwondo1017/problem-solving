{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: run current file",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/run-cpp.sh",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
